      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        520,
        360
      ],
      "webhookId": "vidauto-publish"
    },
    {
      "parameters": {
        "jsCode": "// one item per platform; works for both starts (daily run: every channel's video; Studio button: one video)\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (j.body && j.body.job_id) {\n    for (const p of (j.body.platforms || ['youtube'])) {\n      out.push({ json: { job_id: j.body.job_id, platform: p, mode: j.body.mode || 'auto' } });\n    }\n  } else {\n    const made = $('Сделать ролик').first().json;\n    const videos = made.videos || [{ job_id: made.job_id, platforms: j.platforms || [] }];\n    for (const v of videos) {\n      for (const p of (v.platforms || [])) out.push({ json: { job_id: v.job_id, platform: p, mode: 'auto' } });\n    }\n  }\n}\nreturn out;"
      },
      "id": "a6",
      "name": "По платформам",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://worker:8000/social/' + $json.platform + '/post' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ job_id: $json.job_id, mode: $json.mode }) }}",
        "options": {
          "timeout": 1800000
        }
      },
      "id": "a7",
      "name": "Опубликовать",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
