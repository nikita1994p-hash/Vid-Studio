# Скопируйте этот файл в .env (без .example) и заполните. Пробелы вокруг "=" не ставьте.

# --- Ключ Google AI Studio (https://aistudio.google.com/api-keys). Никому не показывайте.
GEMINI_API_KEY=

# --- Тестовый режим: true = готовый тестовый сценарий про осьминога (без Gemini)
# false = настоящий сценарий от Gemini. На бесплатном тарифе это бесплатно (текст бесплатный).
MOCK=false

# --- О канале (всё, что видит зритель, пишется на английском для США)
CHANNEL_NICHE=real, boring small businesses that quietly make ordinary Americans rich - what each one costs to start, what it really makes, and the first step to start it
CHANNEL_AUDIENCE=American viewers in the United States, 18-35, with a regular job and a few thousand dollars saved, skeptical of get-rich-quick gurus
CHANNEL_LANGUAGE=en
BODY_SCENES=6
# --- Концовка-петля: последняя фраза перетекает в хук, последний кадр = первый кадр (true/false)
LOOP_ENDING=true
# --- Длинную историю ИИ может разбить на 2-3 ролика (Part 1/3...). 1 = никогда не разбивать
MAX_PARTS=3

# --- Серия «365 бизнесов»: номер ролика ставится сам (по истории готовых роликов)
SERIES_NAME=365 Businesses That Make Money
SERIES_RULES=Each episode covers ONE specific, real small business an ordinary American could start. Cover: what it is, typical startup cost, typical monthly profit as a range, the catch, and the first concrete step. Prefer boring local businesses (vending machines, laundromats, pressure washing, self storage, car washes, cleaning, junk removal, mobile services, food trucks) over online-guru schemes. Phrase every money figure as an estimate (about, typically, around). Never promise income. Never invent statistics, percentages, studies or laws - hooks may only use the business own typical cost, price or profit numbers, or facts that are common knowledge. Every money figure, the catch and the first step live inside natural spoken sentences.
SERIES_LABEL="BUSINESS #{n}"
SERIES_TITLE_PREFIX="Business #{n}:"
DESCRIPTION_FOOTER=Numbers are typical US estimates; results vary. Not financial advice.

# --- Картинки/видео в ролике
# auto      = flux (если есть CF_API_TOKEN) -> pexels (если есть PEXELS_API_KEY) -> openverse
# flux      = бесплатно: AI-картинки FLUX.1 schnell на Cloudflare Workers AI (10 000 нейронов в день)
# openverse = бесплатно, без ключа: настоящие фото (CC0 / CC BY), автор пишется в описании сам
# cards  = бесплатно: анимированные карточки с главной цифрой сцены (без ключей)
# pexels = бесплатно: настоящие стоковые видео Pexels (нужен бесплатный ключ: https://www.pexels.com/api/)
# gemini = AI-картинки Gemini (ПЛАТНО: на бесплатном тарифе Google лимит 0)
VISUAL_PROVIDER=auto
PEXELS_API_KEY=
# Cloudflare Workers AI (dash.cloudflare.com -> My Profile -> API Tokens, шаблон Workers AI)
CF_ACCOUNT_ID=
CF_API_TOKEN=
FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
FLUX_STEPS=6

# --- Озвучка
# edge   = бесплатные голоса Microsoft Edge (по умолчанию), точные субтитры по словам
# gemini = Gemini TTS (платно, ~$0.01 за ролик)
TTS_PROVIDER=edge
# Голоса США: en-US-AndrewMultilingualNeural, en-US-BrianMultilingualNeural, en-US-AvaMultilingualNeural,
# en-US-EmmaMultilingualNeural, en-US-ChristopherNeural, en-US-GuyNeural, en-US-JennyNeural, en-US-AriaNeural
EDGE_VOICE=en-US-AndrewMultilingualNeural
EDGE_RATE=+8%
# Только для TTS_PROVIDER=gemini
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Puck
TTS_STYLE=energetic, confident, fast-paced

# --- Где лежат ваши YouTube-скиллы и профиль голоса (прямые слэши!)
SKILLS_DIR=C:/Users/nikit/.claude/skills
YOUTUBE_PROFILE_DIR=C:/Users/nikit/.claude/youtube

# --- Модели Gemini (проверено 27.10.2026; если Google переименует — меняйте здесь)
TEXT_MODEL=gemini-3.8-flash
# если основная модель перегружена (503) или кончилась квота (429) - пробуются эти по очереди
TEXT_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
IMAGE_MODEL=gemini-3.1-flash-lite-image
VIDEO_MODEL=gemini-omni-1.1-flash

# --- Живое AI-видео в первые секунды (≈ +$0.80, ТОЛЬКО на платном тарифе Gemini)
USE_VIDEO_HOOK=false

# --- Время на ВАШЕМ компьютере (для расписания n8n)
TIMEZONE=Europe/Kyiv

# --- Публикация на YouTube
# false = ролик грузится ПРИВАТНЫМ, вы смотрите и публикуете сами (рекомендуется первые недели)
# true  = YouTube сам опубликует в PUBLISH_TIME по часовому поясу PUBLISH_TIMEZONE (время вашей аудитории)
AUTO_PUBLISH=false
PUBLISH_TIME=18:00
PUBLISH_TIMEZONE=America/New_York
AI_DISCLOSURE=true
YOUTUBE_CATEGORY_ID=27
YOUTUBE_REGION=US

# --- Фоновая музыка: data/music (8 треков Kevin MacLeod, автор пишется в описании сам)
MUSIC_VOLUME=0.12
# --- Свуш на смене сцен: data/sfx/transition.wav. 0 = выключить
SFX_VOLUME=0.5

# --- Публичная https-ссылка на Студию (например Cloudflare Tunnel). Нужна только для Threads
# (он сам скачивает видео по ссылке). Пусто = только localhost.
PUBLIC_BASE_URL=
